{
  "expo": {
    "name": "SafariPlug",
    "slug": "safariplug",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "safariplug",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070708"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.safariplug.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070708"
      },
      "package": "com.safariplug.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "24fd985e-5834-4e18-bf13-123ff456a258"
      }
    }
  }
}
